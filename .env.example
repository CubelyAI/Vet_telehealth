# Supabase — copy from your project's Settings → API page
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — from Supabase project Settings → Database → Connection string
DATABASE_URL=           # Use the pooled connection string (port 6543 / Transaction mode)
DIRECT_URL=             # Use the non-pooled connection string (port 5432, for migrations)

# Stripe — from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=  # From `stripe listen` output or Stripe Dashboard webhooks
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=      # e.g. noreply@yourdomain.com (must be a verified domain)

# App
NEXT_PUBLIC_APP_URL=    # e.g. http://localhost:3000 (no trailing slash)
